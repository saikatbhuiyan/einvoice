NODE_ENV=development
GLOBAL_PREFIX=api
API_VERSION=v1
CORS_ORIGINS=*

BFF_PORT=3300
INVOICE_SERVICE_PORT=3301
INVOICE_HTTP_PORT=3302

# Product service
PRODUCT_HTTP_PORT=3303
PRODUCT_SERVICE_PORT=3304

# User access service
USER_ACCESS_HTTP_PORT=3305
USER_SERVICE_PORT=3306
USER_ACCESS_GRPC_PORT=3308

# Authorizer service (gRPC) — replaces bff's old direct TCP call to user-access for permission
# resolution; user-access's own TCP surface above still handles user/role CRUD unchanged.
AUTHORIZER_HTTP_PORT=3309
AUTHORIZER_GRPC_PORT=3307

# PDF generator service — renders invoices to PDF (EJS + Puppeteer against system Chromium), called
# by invoice, never directly by bff.
PDF_GENERATOR_HTTP_PORT=3311
PDF_GENERATOR_SERVICE_PORT=3310

# Media service — thin S3 upload wrapper (StorageProvider), called by invoice to store generated
# PDFs. S3_* below point at the adobe/s3mock container standing in for S3 in dev (MinIO, then
# LocalStack, were tried first — both now gate their easy-to-pull images behind a paid license;
# see docker-compose.dev.yml's s3mock service comment). s3mock doesn't check credentials, so these
# access-key values are placeholders, not secrets.
MEDIA_HTTP_PORT=3313
MEDIA_SERVICE_PORT=3312
S3_BUCKET=einvoice-dev
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=test
S3_SECRET_ACCESS_KEY=test
S3MOCK_PORT=9090

# Payment service — Stripe Checkout sessions + webhook handling. Not a real secret boundary in
# dev (same caveat as the Keycloak fixtures below); use your own Stripe test-mode keys to actually
# exercise the checkout/webhook flow — https://dashboard.stripe.com/test/apikeys. STRIPE_SUCCESS_URL/
# CANCEL_URL only need to resolve well enough for Checkout's redirect; they don't need to be real
# pages for the webhook flow itself to work.
PAYMENT_HTTP_PORT=3314
PAYMENT_SERVICE_PORT=3004
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder
STRIPE_SUCCESS_URL=http://localhost:3300/api/v1/payments/success
STRIPE_CANCEL_URL=http://localhost:3300/api/v1/payments/cancel

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=einvoice_dev
POSTGRES_USER=einvoice_dev_user
POSTGRES_PASSWORD=dev-postgres-password

# pgAdmin
PGADMIN_PORT=5050
PGADMIN_DEFAULT_EMAIL=admin@einvoice.local
PGADMIN_DEFAULT_PASSWORD=dev-pgadmin-password

MONGODB_PORT=27017
MONGO_DB=einvoice_dev
MONGO_ROOT_USERNAME=einvoice_dev_root
MONGO_ROOT_PASSWORD=dev-mongo-password
MONGODB_URI=mongodb://einvoice_dev_root:dev-mongo-password@localhost:27017/einvoice_dev?authSource=admin
MONGODB_DB_NAME=einvoice_dev
MONGODB_MIN_POOL_SIZE=2
MONGODB_MAX_POOL_SIZE=20
MONGODB_CONNECT_TIMEOUT_MS=10000
MONGODB_SOCKET_TIMEOUT_MS=45000
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
MONGODB_HEARTBEAT_FREQUENCY_MS=10000
MONGODB_RETRY_WRITES=true
MONGODB_RETRY_READS=true
MONGODB_DIRECT_CONNECTION=false
MONGODB_READ_PREFERENCE=primary
MONGODB_APP_NAME=einvoice-invoice-service
# MONGODB_READ_URI=mongodb://einvoice_dev_root:dev-mongo-password@localhost:27018/einvoice_dev?authSource=admin&replicaSet=rs0&readPreference=secondaryPreferred

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=dev-redis-password
REDIS_DB=0
CACHE_DEFAULT_TTL=20

RATE_LIMIT_BURST=30
RATE_LIMIT_RATE=2
RATE_LIMIT_KEY_PREFIX=ratelimit

CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RESET_TIMEOUT_MS=30000
CIRCUIT_BREAKER_HALF_OPEN_MAX_PROBES=3
CIRCUIT_BREAKER_LOG_LEVEL=warn

# Keycloak — dev-only fixture credentials, imported from infra/keycloak/realm-export/einvoice-realm.json.
# Not a real secret boundary (same as the Postgres/pgAdmin dev defaults above); do not reuse these values outside local dev.
KEYCLOAK_PORT=8080
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=dev-keycloak-admin-password
KEYCLOAK_REALM=einvoice
KEYCLOAK_CLIENT_ID=einvoice-bff
KEYCLOAK_CLIENT_SECRET=dev-keycloak-bff-secret
# bff reaches Keycloak over the compose network; from the host (e.g. testing with curl) use http://localhost:8080 instead.
KEYCLOAK_BASE_URL=http://localhost:8080
# Publicly reachable address a real browser can resolve, used only for the Authorization Code redirect (login/callback flow) — distinct from KEYCLOAK_BASE_URL, which inside Docker is the internal service hostname.
KEYCLOAK_PUBLIC_BASE_URL=http://localhost:8080
KEYCLOAK_REDIRECT_URI=http://localhost:3300/api/v1/auth/callback
# Client-credentials-only client used by user-access's KeycloakAdminService (create/role-sync/disable users via the Admin REST API) — never used for end-user login.
KEYCLOAK_ADMIN_CLIENT_ID=einvoice-admin-cli
KEYCLOAK_ADMIN_CLIENT_SECRET=dev-keycloak-admin-cli-secret

# Kafka — single-node KRaft broker (see docker-compose.dev.yml's kafka service comment for why
# every KAFKA_* var there is required together). invoice is the only producer today; the topic/
# consumer-group names below are shared with services/mail (Go), which can't read this file
# directly, so keep them in sync by hand if either side changes.
KAFKA_PORT=9092

# services/mail (Go) — not an Nx/pnpm app, but reads the same .env/.env.dev files via
# docker-compose's env_file, same as every TS service. MAIL_PROVIDER=smtp is this file's default
# (development); leave it unset to let APP_ENV pick the default instead.
# MAIL_PROVIDER=smtp

# Gmail SMTP — requires a Google Account with 2-Step Verification enabled, then an App Password
# generated at https://myaccount.google.com/apppasswords (NOT your regular Gmail password, which
# Gmail's SMTP rejects outright for an app like this). Not a real secret boundary like the other
# dev fixtures above, but also not fakeable — sending a real email needs a real App Password here.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-address@gmail.com
SMTP_PASSWORD=your-16-character-app-password
SMTP_FROM=your-address@gmail.com

# AWS SES — only read if MAIL_PROVIDER=ses is set explicitly in dev (the default here is smtp).
AWS_REGION=us-east-1
SES_FROM_EMAIL=invoices@example.com
