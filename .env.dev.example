NODE_ENV=development
GLOBAL_PREFIX=api
API_VERSION=v1
CORS_ORIGINS=*

BFF_PORT=3300
INVOICE_SERVICE_PORT=3301
INVOICE_HTTP_PORT=3302

POSTGRES_PORT=5432
POSTGRES_DB=einvoice_dev
POSTGRES_USER=einvoice_dev_user
POSTGRES_PASSWORD=dev-postgres-password

MONGODB_PORT=27017
MONGO_DB=einvoice_dev
MONGO_ROOT_USERNAME=einvoice_dev_root
MONGO_ROOT_PASSWORD=dev-mongo-password
MONGODB_URI=mongodb://einvoice_dev_root:dev-mongo-password@localhost:27017/einvoice_dev?authSource=admin
MONGODB_DB_NAME=einvoice_dev
MONGODB_MIN_POOL_SIZE=2
MONGODB_MAX_POOL_SIZE=20
MONGODB_CONNECT_TIMEOUT_MS=10000
MONGODB_SOCKET_TIMEOUT_MS=45000
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
MONGODB_HEARTBEAT_FREQUENCY_MS=10000
MONGODB_RETRY_WRITES=true
MONGODB_RETRY_READS=true
MONGODB_DIRECT_CONNECTION=false
MONGODB_READ_PREFERENCE=primary
MONGODB_APP_NAME=einvoice-invoice-service

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=dev-redis-password
REDIS_DB=0
CACHE_DEFAULT_TTL=20

RATE_LIMIT_BURST=30
RATE_LIMIT_RATE=2
RATE_LIMIT_KEY_PREFIX=ratelimit

CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RESET_TIMEOUT_MS=30000
CIRCUIT_BREAKER_HALF_OPEN_MAX_PROBES=3
CIRCUIT_BREAKER_LOG_LEVEL=warn
