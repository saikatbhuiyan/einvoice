NODE_ENV=production
GLOBAL_PREFIX=api
API_VERSION=v1
CORS_ORIGINS=https://app.example.com

BFF_PORT=3300
INVOICE_HTTP_PORT=3302
INVOICE_SERVICE_PORT=3301
PRODUCT_HTTP_PORT=3303
PRODUCT_SERVICE_PORT=3304
USER_ACCESS_HTTP_PORT=3305
USER_SERVICE_PORT=3306
USER_ACCESS_GRPC_PORT=3308

# Authorizer service (gRPC) — replaces bff's old direct TCP call to user-access for permission
# resolution; user-access's own TCP surface above still handles user/role CRUD unchanged.
AUTHORIZER_HTTP_PORT=3309
AUTHORIZER_GRPC_PORT=3307

# PDF generator service — renders invoices to PDF (EJS + Puppeteer against system Chromium),
# called by invoice, never directly by bff. No app-specific secrets.
PDF_GENERATOR_HTTP_PORT=3311
PDF_GENERATOR_SERVICE_PORT=3310

# Media service — thin S3 upload wrapper, called by invoice to store generated PDFs. Talks to
# real AWS S3 here (dev uses a local s3mock container instead; see docker-compose.dev.yml).
# S3_ACCESS_KEY_ID/S3_SECRET_ACCESS_KEY are deliberately NOT set below — leave them unset so the
# AWS SDK falls back to this container's own IAM role (an ECS task role or EC2 instance profile)
# instead of a long-lived static key pair baked into an env var, which is what AWS itself
# recommends whenever the deployment target can actually hold a role. Only set them explicitly
# if this stack runs somewhere with no IAM role available at all (see apps/media's
# S3Configuration/S3StorageProvider for exactly how the fallback works).
MEDIA_HTTP_PORT=3313
MEDIA_SERVICE_PORT=3312
S3_BUCKET=einvoice-prod
S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
# Point at a CDN in front of the bucket (CloudFront, etc.), not the bucket's raw S3 URL directly,
# if invoice PDFs need to be served to end users at any real scale — unset falls back to the
# standard virtual-hosted-style S3 URL (https://<bucket>.s3.<region>.amazonaws.com/<key>), which
# works but bypasses any CDN caching/TLS termination you'd otherwise want in front of it.
# S3_PUBLIC_BASE_URL=https://cdn.example.com

# Payment service — Stripe Checkout sessions + webhook handling. Real secrets, not dev fixtures:
# get the live-mode keys from https://dashboard.stripe.com/apikeys (STRIPE_SECRET_KEY) and the
# webhook signing secret from the endpoint you register at
# https://dashboard.stripe.com/webhooks pointed at https://app.example.com/api/v1/payments/webhook
# (STRIPE_WEBHOOK_SECRET — each registered endpoint gets its own, distinct from any test-mode one
# you used locally). STRIPE_SUCCESS_URL/CANCEL_URL need real, reachable domains, unlike the
# localhost defaults in .env.dev.example. The payments table migration is NOT run automatically
# on container start here (same as product's/user-access's own Postgres tables) — run
# `pnpm payment:migration:run` against the production database as a deploy step before the
# payment service's first rollout.
PAYMENT_HTTP_PORT=3314
PAYMENT_SERVICE_PORT=3004
STRIPE_SECRET_KEY=change-me-stripe-secret-key
STRIPE_WEBHOOK_SECRET=change-me-stripe-webhook-secret
STRIPE_SUCCESS_URL=https://app.example.com/payments/success
STRIPE_CANCEL_URL=https://app.example.com/payments/cancel

POSTGRES_DB=einvoice
POSTGRES_USER=einvoice_user
POSTGRES_PASSWORD=change-me-postgres-password

MONGO_DB=einvoice
MONGO_ROOT_USERNAME=einvoice_root
MONGO_ROOT_PASSWORD=change-me-mongo-password
MONGODB_URI=mongodb://einvoice_root:change-me-mongo-password@mongodb:27017/einvoice?authSource=admin
MONGODB_DB_NAME=einvoice
MONGODB_MIN_POOL_SIZE=5
MONGODB_MAX_POOL_SIZE=50
MONGODB_CONNECT_TIMEOUT_MS=10000
MONGODB_SOCKET_TIMEOUT_MS=45000
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
MONGODB_HEARTBEAT_FREQUENCY_MS=10000
MONGODB_RETRY_WRITES=true
MONGODB_RETRY_READS=true
MONGODB_DIRECT_CONNECTION=false
MONGODB_READ_PREFERENCE=primary
MONGODB_APP_NAME=einvoice-invoice-service
# MONGODB_READ_URI=mongodb+srv://einvoice_root:change-me-mongo-password@mongodb-rs.einvoice.svc.cluster.local/einvoice?replicaSet=rs0&readPreference=secondaryPreferred

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change-me-redis-password
REDIS_DB=0
CACHE_DEFAULT_TTL=20

# Keycloak — unlike the dev fixtures elsewhere in this file, these are NOT safe to leave as
# placeholders. KEYCLOAK_CLIENT_SECRET and KEYCLOAK_ADMIN_CLIENT_SECRET must match whatever
# secrets you actually set on the einvoice-bff and einvoice-admin-cli clients when you configure
# the realm by hand (console or Admin REST API) — the dev-only realm-export JSON with its
# hardcoded test credentials is never imported here; see docker-compose.prod.yml's keycloak
# service for why. KEYCLOAK_PUBLIC_BASE_URL and KEYCLOAK_REDIRECT_URI need real domains once you
# have TLS/DNS in front of this stack.
KEYCLOAK_PORT=8080
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-keycloak-admin-password
KEYCLOAK_REALM=einvoice
KEYCLOAK_CLIENT_ID=einvoice-bff
KEYCLOAK_CLIENT_SECRET=change-me-keycloak-bff-secret
KEYCLOAK_PUBLIC_BASE_URL=https://auth.example.com
KEYCLOAK_REDIRECT_URI=https://app.example.com/api/v1/auth/callback
KEYCLOAK_ADMIN_CLIENT_ID=einvoice-admin-cli
KEYCLOAK_ADMIN_CLIENT_SECRET=change-me-keycloak-admin-cli-secret

RATE_LIMIT_BURST=30
RATE_LIMIT_RATE=2
RATE_LIMIT_KEY_PREFIX=ratelimit

CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RESET_TIMEOUT_MS=30000
CIRCUIT_BREAKER_HALF_OPEN_MAX_PROBES=3
CIRCUIT_BREAKER_LOG_LEVEL=warn
