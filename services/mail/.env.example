# APP_ENV picks the mail provider default (development -> smtp, anything else -> ses) unless
# MAIL_PROVIDER overrides it explicitly. Compose sets these; this file documents what's needed
# when running `go run ./cmd/mail` directly on the host instead.
APP_ENV=development

KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC_INVOICE_EVENTS=invoice.events
KAFKA_CONSUMER_GROUP=mail-service

# MAIL_PROVIDER=smtp|ses -- leave unset to use the APP_ENV default above.
# MAIL_PROVIDER=smtp

# Gmail SMTP (dev default). Requires a Google Account with 2-Step Verification enabled, then an
# App Password generated at https://myaccount.google.com/apppasswords -- NOT your regular Gmail
# password, which Gmail's SMTP will reject outright for an app like this.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-address@gmail.com
SMTP_PASSWORD=your-16-character-app-password
SMTP_FROM=your-address@gmail.com

# AWS SES (staging/production default). No static access keys here on purpose -- the AWS SDK's
# default credential chain picks up an ECS task role / EC2 instance profile in real deployments.
# Only set AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY (standard AWS SDK env vars, not something this
# service reads itself) if running somewhere with no IAM role available at all.
AWS_REGION=us-east-1
SES_FROM_EMAIL=invoices@example.com
