{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc",
    "module": "commonjs",
    "moduleResolution": "node10",
    // ts-jest compiles @nestjs/passport's ESM source with this config, and it default-imports the
    // CommonJS `passport` package — without interop that import is undefined (apps/bff sets it too).
    "esModuleInterop": true,
    "types": ["jest", "node"]
  },
  "include": ["jest.config.ts", "jest.config.cts", "src/**/*.test.ts", "src/**/*.spec.ts", "src/**/*.d.ts"]
}
